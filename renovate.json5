{
  extends: [
    'github>nolte/gh-plumbing//renovate-configs/common#v2.2.1',
  ],
  mode: 'full',
  separateMajorMinor: true,
  separateMinorPatch: false,
  packageRules: [
    {
      groupName: 'github-actions',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
    },
    {
      groupName: 'github-actions major',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'major',
      ],
    },
    {
      groupName: 'pre-commit hooks',
      matchManagers: [
        'pre-commit',
      ],
      automerge: true,
    },
    {
      // Terraform, TFLint (.tool-versions) and the TFLint ruleset run in CI
      // and in pre-commit; one PR keeps them in step.
      groupName: 'terraform tooling',
      matchManagers: [
        'asdf',
        'tflint-plugin',
      ],
      automerge: false,
    },
    {
      // The bpg/proxmox provider is pre-1.0 and renames resources between
      // minors. Every bump needs `task test` and a look at the changelog.
      groupName: 'terraform providers',
      matchManagers: [
        'terraform',
      ],
      matchDepTypes: [
        'provider',
        'required_provider',
      ],
      automerge: false,
    },
    {
      // The docs toolchain is pinned in docs/requirements.txt. Group the
      // bumps so a MkDocs/Material pair lands in one PR rather than two that
      // each break `mkdocs build --strict` on their own.
      groupName: 'mkdocs toolchain',
      matchFileNames: [
        'docs/requirements.txt',
      ],
      automerge: false,
    },
  ],
}
